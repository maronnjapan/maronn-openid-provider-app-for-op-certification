{
  "name": "maronn-openid-provider-app-for-op-certification",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "tsx scripts/deploy.ts",
    "setup:local": "tsx scripts/deploy.ts --local",
    "destroy": "tsx scripts/destroy.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --strict-vars=false",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit"
  },
  "dependencies": {
    "@maronn-openid-connect/core": "^0.8.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@maronn-openid-connect/cli": "^0.13.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.110.0"
  }
}
